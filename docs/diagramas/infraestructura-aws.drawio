        <mxCell id="failure" parent="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;color:#945916&quot;&gt;Aislamiento de fallos de entrega&lt;/div&gt;&lt;div style=&quot;margin-top:4px&quot;&gt;Cuatro DLQ de consumo, con hasta cinco recepciones antes del envío a DLQ.&lt;br&gt;Una quinta DLQ recoge fallos de entrega de Scheduler a SQS.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E2;strokeColor=#945916;strokeWidth=1.4;fontFamily=Arial;fontSize=14;fontColor=#193249;align=left;verticalAlign=middle;spacingLeft=61;spacingRight=14;" vertex="1">
